root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Trailing whitespace is significant in Markdown (hard line break).
trim_trailing_whitespace = false

[Makefile]
# make requires literal tabs for recipe lines.
indent_style = tab

[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = 2
