# ─────────────────────────────────────────────────────────────────────────────
# Copy to infra/.env and fill in. infra/.env is git-ignored and must stay so.
#
#   cp infra/.env.example infra/.env
#
# No workflow secrets belong here. Gmail and Gemini credentials are created
# inside the n8n UI and bound to workflows by name — see docs/CREDENTIALS.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ───────────────────────────────────────────────────────────────—

# Encrypts every credential n8n stores. Generate one with:
#   openssl rand -base64 32
#
# ALREADY RUNNING n8n? Do not generate a new key. Copy the existing value out of
# your data directory instead, or n8n will be unable to decrypt the credentials
# it already has:
#   cat data/config      # → {"encryptionKey": "..."}
#
# Back this value up somewhere outside the repo. Lose it and every stored OAuth
# token and API key becomes unrecoverable.
N8N_ENCRYPTION_KEY=CHANGE_ME

# ── Tooling (make export / make import) ─────────────────────────────────────

# Create in n8n: Settings → n-8n API → Create an API key.
# Only needed to move workflow definitions between n8n and this repo. It cannot
# read credential secrets.
N8N_API_KEY=
N8N_BASE_URL=http://localhost:5678

# ── Host / networking ───────────────────────────────────────────────────────

# Host port published on your machine. Change it if 5678 is already taken —
# for example if you already run another n8n container.
N8N_PORT=5678

N8N_HOST=localhost
N8N_PROTOCOL=http

# Must be reachable by any external service that calls a webhook. For local
# development leave as is; behind a reverse proxy use the public URL.
WEBHOOK_URL=http://localhost:5678/

# ── Behaviour ───────────────────────────────────────────────────────────────

# n8n defaults to America/New_York when this is unset, which shifts every cron
# trigger and every $now used in an expression.
GENERIC_TIMEZONE=Europe/Tirane

# Hours of execution history to keep (336 = 14 days).
EXECUTIONS_DATA_MAX_AGE=336

# error | warn | info | verbose | debug
N8N_LOG_LEVEL=info

# ── Production profile only (docker-compose.prod.yml) ───────────────────────

POSTGRES_DB=n8n
POSTGRES_USER=n8n
# Required when using the prod overlay. Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=
